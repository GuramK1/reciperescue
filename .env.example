# No external requests are made in demo mode. Set false to use your provider.
DEMO_MODE=true
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
# Enable only when the configured model accepts image_url input.
AI_SUPPORTS_IMAGES=false
# json_schema, json_object, or none (all responses are still validated).
AI_RESPONSE_FORMAT=json_schema
AI_TIMEOUT_MS=45000
DATABASE_PATH=./data/reciperescue.db
# Optional explicit origin for a reverse proxy, e.g. https://rescue.example.com
APP_ORIGIN=
# Build-only: Docker enables standalone output; keep false for npm start.
BUILD_STANDALONE=false
